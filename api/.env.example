# Copiar a .env y completar
DATABASE_URL=postgres://mitrailer:mitrailer_dev@localhost:5432/mitrailer
PORT=3000
CORS_ORIGENES=http://localhost:8790,https://app.camiones-wang.workers.dev
# En producción son obligatorias (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CEDULA_CLAVE=
PIMIENTA=
# Correo para enviar los códigos de acceso (si se deja vacío, el código se muestra en la consola)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=Mi Trailer <no-responder@camiones-wang.ec>
CARPETA_ARCHIVOS=./archivos
# Opcional: certificado CA del proveedor de PostgreSQL (si no es de una autoridad pública)
PG_CA_CERT=
# Proxies delante del servidor (Render = 1; local sin proxy = 0)
TRUST_PROXY=1
