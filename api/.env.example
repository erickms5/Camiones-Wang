# Copiar a .env y completar
# Sin DATABASE_URL (solo en desarrollo) se usa una base local en la carpeta api/datos-locales: no hace falta instalar PostgreSQL
DATABASE_URL=postgres://mitrailer:mitrailer_dev@localhost:5432/mitrailer
PORT=3000
CORS_ORIGENES=http://localhost:8790,http://127.0.0.1:8790,https://app.camiones-wang.workers.dev
# En producción son obligatorias (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
CEDULA_CLAVE=
PIMIENTA=
CARPETA_ARCHIVOS=./archivos
# Opcional: certificado CA del proveedor de PostgreSQL (si no es de una autoridad pública)
PG_CA_CERT=
# Proxies delante del servidor (Render = 1; local sin proxy = 0)
TRUST_PROXY=1
# Cuenta del administrador: se crea al arrancar si no existe (contraseña de al menos 10 caracteres).
# Para restablecer una contraseña olvidada: poner ADMIN_RESTABLECER=si, arrancar una vez y quitarlo.
ADMIN_EMAIL=
ADMIN_CLAVE=
ADMIN_NOMBRE=Administrador
